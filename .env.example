# Copy this file to .env and fill in real values.
# .env is not committed (see .gitignore) — never put real secrets in this file.

# Flask session signing key. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: overrides the default local sqlite database.
DATABASE_URL=sqlite:///crypto_db.db

# SMTP account used to send OTP QR codes and diplomas by email.
EMAIL_FROM=
EMAIL_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Shared TOTP seed used to generate/verify the admin's OTP.
TOTP_SECRET=

# Passphrase protecting ressources/private/key.pem.
RSA_KEY_PASSPHRASE=

# Dev server settings.
FLASK_DEBUG=1
FLASK_PORT=8000
